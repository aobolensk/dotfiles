[include]
	path = .gitconfig_local
	# machine specific settings
[branch]
	autoSetupMerge = always
[core]
	excludesfile = ~/.gitignore_global
[color]
	ui = auto
[credential]
	helper = store
[alias]
	a = add
	b = branch
	c = commit
	ca = commit --amend
	cb = checkout -b
	cco = "!cco() { git fetch --all --prune && git branch -D \"$1\" 2>/dev/null; git checkout \"$1\"; }; cco"
	cl = clone --recurse-submodules
	co = checkout
	cp = cherry-pick
	cpa = cherry-pick --abort
	cpc = -c core.editor=true cherry-pick --continue
	cps = cherry-pick --skip
	d = diff
	ds = diff --staged
	f = fetch
	fa = fetch aobolensk
	fo = fetch origin
	fu = fetch upstream
	h = "!git head"
	head = "!git rev-parse --abbrev-ref HEAD"
	l = log
	mg = merge --no-edit
	mga = merge --abort
	mgc = -c core.editor=true merge --continue
	p = push
	pl = pull --prune --rebase
	pla = pull --prune --all
	plas = pull --prune --rebase --autostash
	pls = "!git pull --prune --rebase && git submodule update --init --recursive"
	pah = "!git push aobolensk $(git head)"
	plah = "!git pl aobolensk $(git head)"
	ploh = "!git pl origin $(git head)"
	poh = "!git push origin $(git head)"
	pr = "!pr() { git fetch origin \"pull/$1/head:pr/$1\" && git checkout \"pr/$1\"; }; pr"
	puh = "!git push upstream $(git head)"
	rb = rebase
	rba = rebase --abort
	rbc = -c core.editor=true rebase --continue
	rbs = rebase --skip
	rv = revert --no-edit
	rva = revert --abort
	rvc = -c core.editor=true revert --continue
	rvs = revert --skip
	s = status
	st = stash
	sta = stash apply
	stu = stash push --keep-index
	su = submodule update --init --recursive
	sw = switch
	tree = log --graph --pretty=oneline --abbrev-commit
	uncommit = reset --soft HEAD~1
	undo = reset --hard
	unstage = restore --staged
	wt = worktree
	wta = worktree add
	wtl = worktree list
	wtr = worktree remove
[push]
	autoSetupRemote = true
	default = current
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[lfs]
	locksverify = false
